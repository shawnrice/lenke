{
  "name": "@lenke/native",
  "description": "JavaScript/TypeScript bindings to the Rust `lenke-engine` columnar graph engine, with a single facade over native (FFI) and WebAssembly backends.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "./ffi-engine": {
      "types": "./dist/types/backend-ffi-engine.d.ts",
      "default": "./dist/esm/backend-ffi-engine.mjs"
    },
    "./wasm-engine": {
      "types": "./dist/types/backend-wasm-engine.d.ts",
      "default": "./dist/esm/backend-wasm-engine.mjs"
    },
    "./arrow": {
      "types": "./dist/types/arrow.d.ts",
      "default": "./dist/esm/arrow.mjs"
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "build:rust": "cargo build --release --features capi --manifest-path ../../crates/lenke-engine/Cargo.toml",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --target-dir ../../crates/lenke-engine/target-wasm --no-default-features --features capi,codecs --manifest-path ../../crates/lenke-engine/Cargo.toml",
    "engine:build:rust": "cargo build --release --features capi --manifest-path ../../crates/lenke-engine/Cargo.toml",
    "engine:build:wasm": "cargo build --release --target wasm32-unknown-unknown --target-dir ../../crates/lenke-engine/target-wasm --no-default-features --features capi,codecs --manifest-path ../../crates/lenke-engine/Cargo.toml",
    "test": "bun test",
    "test:engine": "LENKE_ENGINE=1 bun test",
    "fuzz": "bun fuzz.ts",
    "bench": "bun bench.ts",
    "bench:usage": "bun bench-usage.ts",
    "spelling": "bun spelling-probe.ts",
    "delete:width": "bun delete-width-probe.ts",
    "addedge:cost": "bun addedge-cost-probe.ts",
    "bench:gremlin": "bun bench-gremlin.ts",
    "probe:depth": "bun chain-depth-probe.ts",
    "probe:layout": "bun chain-layout-probe.ts",
    "probe:gap": "bun engine-gap-probe.ts",
    "probe:writes": "bun write-gap-probe.ts",
    "probe:route": "bun route-cost-probe.ts",
    "bench:chain": "bun chain-sweep-bench.ts",
    "bench:gate": "bun chain-gate-bench.ts",
    "xref": "bun xref-probe.ts",
    "probe:scalar": "bun scalarfn-probe.ts",
    "probe:surface": "bun surface-probe.ts",
    "probe:hopladder": "bun hop-filter-ladder-probe.ts",
    "probe:hopmap": "bun hop-filter-route-map-probe.ts",
    "probe:nativehopchain": "bun native-hop-filter-chain-probe.ts",
    "probe:arity": "bun cross-surface-arity-probe.ts",
    "probe:elemread": "bun elemread-probe.ts",
    "probe:adjlayout": "bun adjlayout-probe.ts"
  },
  "dependencies": {
    "@lenke/core": "workspace:*",
    "@lenke/errors": "workspace:*"
  },
  "devDependencies": {
    "@lenke/dev": "workspace:*",
    "@types/bun": "^1.4.1",
    "apache-arrow": "^21.2.0",
    "bun-types": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.0"
  }
}
