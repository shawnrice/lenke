{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./lint-rules/padding-lines.js",
    "./lint-rules/module-boundaries.js",
    "@lenke/lint"
  ],
  // Built-in plugins. `import` is OFF by default and carries `no-cycle`.
  "plugins": ["import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "padding-lines/before-exit": "error",
    "boundaries/no-cross-package-relative-import": "error",
    "lenke/no-raw-interpolation": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "curly": ["error", "all"],
    "no-else-return": ["error", { "allowElseIf": false }],
    "yoda": ["error", "never", { "exceptRange": true }],
    "no-unused-vars": "off",
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "no-param-reassign": ["error", { "props": false }],
    "no-return-assign": "error",
    "no-multi-assign": "error",
    "func-style": ["error", "expression", { "overrides": { "namedExports": "ignore" } }],
    "no-template-curly-in-string": "error",
    "no-self-compare": "error",
    "no-constructor-return": "error",
    "no-unneeded-ternary": "error",
    "prefer-template": "error",
    "prefer-object-has-own": "error",
    "prefer-exponentiation-operator": "error",
    "no-lonely-if": "error",
    "no-nested-ternary": "error",
    "no-shadow": "error",
    "no-lone-blocks": "error",
    "no-labels": "error",
    "no-label-var": "error",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-fallthrough": "error",
    "no-inline-comments": "off",
    "no-inner-declarations": "error",
    // Structural limits. `max-lines` counts CODE, not comments: the comments in this repo are
    // the audit trail (measured numbers, item references, why a rewrite declines a shape), and
    // a cap that counted them would reward deleting them. Code-only, only two files exceed 3000.
    "max-lines": ["error", { "max": 3000, "skipComments": true, "skipBlankLines": true }],
    "import/no-cycle": "error",
    "max-params": ["error", { "max": 6 }],
    "max-statements": ["error", { "max": 80 }],
    "max-nested-callbacks": ["error", { "max": 5 }],
    "max-depth": ["error", { "max": 5 }],
    "complexity": ["error", { "max": 35 }],
    "prefer-destructuring": "error",
    "default-case-last": "error",
    "grouped-accessor-pairs": "error",
    "operator-assignment": "error",

    "import/no-default-export": "error",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "error",
    "import/no-commonjs": "error",

    "typescript/no-non-null-assertion": "off",
    "typescript/no-explicit-any": "off",
    "typescript/ban-ts-comment": "off",

    "typescript/only-throw-error": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/unified-signatures": "error",
    "typescript/no-useless-constructor": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/consistent-type-exports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-inferrable-types": ["error", { "ignoreProperties": true }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-array-delete": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-includes": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/no-deprecated": "error",
    "typescript/prefer-for-of": "error",

    "unicorn/prefer-set-has": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/error-message": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "max-statements": "off",
        "max-nested-callbacks": "off",
        "no-shadow": "off",
        "typescript/require-array-sort-compare": "off",
        "lenke/no-raw-interpolation": "off"
      }
    },
    {
      "files": ["**/*.test.js"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      "files": ["examples/**"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off"
      }
    },
    {
      // ⚠️ TO RE-MEASURE THIS LIST, USE A CONFIG WITHOUT THESE OVERRIDES. Running
      // `oxlint -A all -D import/no-cycle` still applies them, so every file listed here
      // reports clean and the list looks finished. That misreading nearly booked a false
      // win: 31 files were still cyclic while the measurement said 0.
      // RATCHET, not an exemption: these are the files already in an import cycle when the rule
      // was turned on. Listing them individually means any NEW cycle anywhere errors, and the
      // list only ever shrinks. Delete an entry when its cycle goes; do not add one.
      "files": [
        "packages/gremlin/src/executor/aggregation.ts",
        "packages/gremlin/src/executor/cardinality.ts",
        "packages/gremlin/src/executor/dispatch.ts",
        "packages/gremlin/src/executor/filters.ts",
        "packages/gremlin/src/executor/iteration.ts",
        "packages/gremlin/src/executor/match.ts",
        "packages/gremlin/src/executor/misc.ts",
        "packages/gremlin/src/executor/movement.ts",
        "packages/gremlin/src/executor/mutation.ts",
        "packages/gremlin/src/executor/optional-hop.ts",
        "packages/gremlin/src/executor/projection.ts",
        "packages/gremlin/src/executor/runtime.ts",
        "packages/gremlin/src/executor/sack.ts",
        "packages/gremlin/src/executor/shortest-path.ts",
        "packages/gremlin/src/executor/side-effects.ts",
        "packages/gremlin/src/executor/sources.ts",
        "packages/gremlin/src/executor/stream.ts",
        "packages/list/src/List.ts",
        "packages/list/src/functions/empty.ts",
        "packages/list/src/functions/from.ts",
        "packages/list/src/functions/index.ts",
        "packages/list/src/functions/isList.ts",
        "packages/list/src/functions/of.ts",
        "packages/tree/src/TreeNode/TreeNode.ts",
        "packages/tree/src/TreeNode/deserialize.ts"
      ],
      "rules": { "import/no-cycle": "off" }
    },
    {
      // The same ratchet for file size. shortcuts.ts is 5891 CODE lines; everything else in the
      // repo is now under 3000 — core.ts came off this list at 2822 after nine extractions.
      "files": ["packages/gql/src/executor/shortcuts.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      // `execEpoch` is exported as a mutable binding on purpose — it is read PER ROW inside the
      // closure `memoizeIfUncorrelated` returns, so an accessor would put a call in a hot loop.
      // The module header carries the full reasoning. Every other value there is an accessor.
      "files": ["packages/gql/src/executor/compile-state.ts"],
      "rules": { "import/no-mutable-exports": "off" }
    },
    {
      // A build-tool config is CONSUMED as a default export; the rule is right everywhere else.
      "files": ["**/*.config.ts", "**/*.config.js"],
      "rules": { "import/no-default-export": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", ".tsc_d", ".nx/"]
}
